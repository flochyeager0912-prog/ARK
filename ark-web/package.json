{
  "name": "ark-web",
  "version": "1.0.0",
  "private": true,
  "description": "The Ark Victory Church - public website & app (v1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "images:optimize": "tsx scripts/optimize-images.ts",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "test:sync": "tsx tests/e2e/sync.ts",
    "test:pwa": "tsx tests/e2e/pwa.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "predev": "tsx scripts/index-images.ts",
    "prebuild": "tsx scripts/index-images.ts",
    "images:index": "tsx scripts/index-images.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "4.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "^1.65.1",
    "prisma": "^6.19.3",
    "tailwindcss": "4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch@^10.2.2": "^11.0.8"
  }
}
