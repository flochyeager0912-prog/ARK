# ---------------------------------------------------------------------------
# The Ark Victory Church - ark-web environment variables
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Used in emails, sitemap, QR/manage links.
SITE_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://ark:ark@localhost:5434/ark?schema=public

# Secret used to sign admin sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First admin account (used by `npm run db:seed` / `npm run admin:create`)
ADMIN_EMAIL=admin@thearkvictorychurch.com
ADMIN_PASSWORD=
ADMIN_NAME="Church Office"

# --- Email (SMTP). If SMTP_HOST is empty, emails are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="The Ark Victory Church <no-reply@thearkvictorychurch.com>"
# Where enquiry / volunteer / registration notifications for staff are sent
OFFICE_NOTIFY_EMAIL=infovci@thearkvictorychurch.com

# --- Cloudflare Turnstile (optional bot protection). Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Number of reverse proxies in front of the app (for client-IP detection in rate limits)
TRUSTED_PROXY_COUNT=1
